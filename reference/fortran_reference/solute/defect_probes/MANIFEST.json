{
  "schema_version": "hydrus-defect-probe-manifest-v1",
  "description": "Input decks and expected comparison results for source defects SD-001 and SD-002 against pinned HYDRUS Fortran reference",
  "entries": [
    {
      "sd_id": "SD-001",
      "title": "MassInit scales Henry constant by sorption temperature coefficient",
      "description": "In MassInit (SOLUTE.FOR:1933), Par(6)=ChPar(jjj+10,M)*exp(TDep(jjj+7)*TT). Correct code would use TDep(jjj+10), but pinned code uses TDep(jjj+7).",
      "pairs": {
        "defect": {
          "deck_a": "sd001_defect_a",
          "deck_b": "sd001_defect_b",
          "varied_input": {
            "file": "SELECTOR.IN",
            "line_description": "Block D Temperature coefficient records for species 1 (line 60, token 4)",
            "parameter": "TDep(jjj+10) (Henry constant temperature factor)",
            "value_a": 0.0,
            "value_b": 5000.0
          },
          "compared_output": {
            "file": "NOD_INF.OUT",
            "time": 0.0,
            "variable": "Conc(1)",
            "nodes": "all (1..9)",
            "description": "Initial liquid concentration from total mass initialization at t=0"
          },
          "expected_pinned_result": "identical"
        },
        "control": {
          "deck_a": "sd001_control_a",
          "deck_b": "sd001_control_b",
          "varied_input": {
            "file": "SELECTOR.IN",
            "line_description": "Block D Temperature coefficient records for species 1 (line 60, token 1)",
            "parameter": "TDep(jjj+7) (Sorption coefficient temperature factor)",
            "value_a": 500.0,
            "value_b": 5000.0
          },
          "compared_output": {
            "file": "NOD_INF.OUT",
            "time": 0.0,
            "variable": "Conc(1)",
            "nodes": "all (1..9)",
            "description": "Initial liquid concentration from total mass initialization at t=0"
          },
          "expected_pinned_result": "different"
        }
      }
    },
    {
      "sd_id": "SD-002",
      "title": "Bacteria second-site sorption uses first site rates",
      "description": "In NonEqInit (SOLUTE.FOR:1698) and MassInit (SOLUTE.FOR:1942), xKs2=Theta(i)*rKa1/ro/rKd1 reuses site 1 attachment/detachment rates instead of rKa2/rKd2.",
      "pairs": {
        "defect": {
          "deck_a": "sd002_defect_a",
          "deck_b": "sd002_defect_b",
          "varied_input": {
            "file": "SELECTOR.IN",
            "line_description": "Block D Species 1 ChPar line 47 (token 10)",
            "parameter": "rKa2 (second site attachment rate)",
            "value_a": 2.0,
            "value_b": 8.0
          },
          "compared_output": {
            "file": "NOD_INF.OUT",
            "time": 0.0,
            "variable": "Sorb2(1)",
            "nodes": "all (1..9)",
            "description": "Initial nonequilibrium second-site sorbed concentration at t=0"
          },
          "expected_pinned_result": "identical"
        },
        "control": {
          "deck_a": "sd002_control_a",
          "deck_b": "sd002_control_b",
          "varied_input": {
            "file": "SELECTOR.IN",
            "line_description": "Block D Species 1 ChPar line 47 (token 13)",
            "parameter": "rKa1 (first site attachment rate)",
            "value_a": 0.5,
            "value_b": 2.5
          },
          "compared_output": {
            "file": "NOD_INF.OUT",
            "time": 0.0,
            "variable": "Sorb(1) and Sorb2(1)",
            "nodes": "all (1..9)",
            "description": "Initial nonequilibrium sorbed concentrations at t=0"
          },
          "expected_pinned_result": "different"
        }
      }
    }
  ],
